# Supabase — copiar en .env.local (nunca subir valores reales al repo)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo servidor (service role) — NUNCA exponer al cliente. Se usa en
# route handlers / server actions para validar resultados de partidos.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Moderación de avatares: sistema de reportes comunitario
# (3 reportes = foto eliminada + baneo de subida). Sin claves externas.
