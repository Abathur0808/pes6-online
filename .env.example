# Supabase — copiar en .env.local (nunca subir valores reales al repo)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo servidor (service role) — NUNCA exponer al cliente. Se usa en
# route handlers / server actions para validar resultados de partidos.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sightengine — moderación de avatares (plan gratis en sightengine.com).
# Sin estas claves la subida funciona pero SIN filtro de contenido.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
